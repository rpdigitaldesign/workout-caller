# Anthropic (server-side only — never prefix with NEXT_PUBLIC_)
# Set this in Vercel for PRODUCTION only. Previews do not need it (AI features show "unavailable" there).
ANTHROPIC_API_KEY=

# Supabase (public — safe to expose to the browser; access is enforced by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Note: the app never uses the Supabase service-role key. Do not add it here or in Vercel.
