# Anthropic (server-side only — never prefix with NEXT_PUBLIC_)
ANTHROPIC_API_KEY=

# Supabase (public — safe to expose to the browser; access is enforced by Row Level Security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key — server-side only, used for admin/setup scripts.
# Never prefix with NEXT_PUBLIC_. Never import this in client components.
SUPABASE_SERVICE_ROLE_KEY=
